# AVD Workload Pattern — environment variables for local/standalone runs
# Copy to .env and fill in. On ECP, the vended Azure DevOps pipeline provides these.

# Azure context (overrides the hcl configuration in environments/)
ECP_TG_TENANT_ID=
ECP_TG_SUBSCRIPTION_ID=

# Terraform remote state backend (tier 2 — one storage account for the workload)
ECP_TG_BACKEND_SUBSCRIPTION_ID=
ECP_TG_BACKEND_RESOURCE_GROUP_NAME=
ECP_TG_BACKEND_NAME=
ECP_TG_BACKEND_CONTAINER=tfstate

# Optional per-level overrides (tier 1 — ECP platform pipeline compatibility)
# ECP_TG_BACKEND_LEVEL0_SUBSCRIPTION_ID=
# ECP_TG_BACKEND_LEVEL0_RESOURCE_GROUP_NAME=
# ECP_TG_BACKEND_LEVEL0_NAME=
# ECP_TG_BACKEND_LEVEL0_CONTAINER=
